# Copy to a local file and fill in real values. Never commit real values.
# Spring Boot does NOT read this file automatically: set these as environment
# variables in your shell or IDE run configuration (see README).

# Google OAuth2 client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Signing key for OUR application JWT (use at least 32 random characters)
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/electromart?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# Frontend origin (CORS + redirects) and cookie flags
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
